# --- Database ---
# SQLite for local dev. For Postgres (Vercel): set PRISMA_SCHEMA=prisma/schema.postgres.prisma
# and DATABASE_URL to your Postgres connection string.
PRISMA_SCHEMA=prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# --- App ---
APP_BASE_URL="http://localhost:3000"
# Secret guarding POST /api/cron/daily (Vercel Cron). Set a long random value in production.
CRON_SECRET="change-me-in-production"
# Secret for signing per-contact unsubscribe tokens. If unset, a random per-process secret is used (tokens invalidate on restart).
UNSUBSCRIBE_SECRET=""

# --- Sending ---
# console | enginemailer | mailchimp | resend
# In hosted mode (HOSTED_MODE=true) the default is resend; otherwise console.
EMAIL_PROVIDER="console"

# --- Hosted mode (Resend) ---
# When true, signups can send immediately: Resend is the default provider,
# no per-user provider setup needed. See README "Hosted mode (Resend)".
HOSTED_MODE="false"
# Max emails one workspace may send per UTC day (reputation protection).
HOSTED_DAILY_SEND_CAP="1000"

# Resend (https://resend.com) — needed when EMAIL_PROVIDER=resend or HOSTED_MODE=true
RESEND_API_KEY=""
# A domain verified in the Resend dashboard (SPF/DKIM). Platform sends From: noreply@<this domain>.
RESEND_FROM_DOMAIN="mail.example.com"
RESEND_FROM_NAME="Example"
# Signing secret for the Resend webhook (starts with whsec_). Required in hosted mode.
RESEND_WEBHOOK_SECRET=""

# EngineMailer (https://api.enginemailer.com) — needed when EMAIL_PROVIDER=enginemailer
ENGINEMAILER_API_KEY=""
ENGINEMAILER_FROM_EMAIL="mail@example.com"
ENGINEMAILER_FROM_NAME="Example"

# Mailchimp Transactional (Mandrill) — needed when EMAIL_PROVIDER=mailchimp
MANDRILL_API_KEY=""
MANDRILL_FROM_EMAIL="mail@example.com"
MANDRILL_FROM_NAME="Example"
